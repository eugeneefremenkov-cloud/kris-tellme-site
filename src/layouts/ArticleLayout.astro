---
import BaseLayout from "./BaseLayout.astro";
import TgButton from "../components/TgButton.astro";
import { TOPIC_LABELS } from "../content.config";
import type { CollectionEntry } from "astro:content";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  related?: CollectionEntry<"articles">[];
}

const { title, description, pubDate, related = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

function formatDateShort(date: Date): string {
  return date.toLocaleDateString("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

<BaseLayout title={`${title} — КРИС, СКАЖИ МНЕ`} description={description}>
  <article class="max-w-2xl mx-auto px-4 sm:px-8 py-12 sm:py-16">
    <a href="/articles/" class="text-sm text-sage-700 hover:text-sage-800 transition-colors duration-200 cursor-pointer">← Ко всем статьям</a>

    <header class="flex flex-col gap-3 mt-6 mb-10">
      <time datetime={pubDate.toISOString()} class="text-sm text-graphite-muted">
        {formattedDate}
      </time>
      <h1 class="font-serif text-3xl sm:text-4xl leading-tight text-graphite font-medium">
        {title}
      </h1>
      <p class="text-lg text-graphite/70 leading-relaxed">{description}</p>
    </header>

    <div class="prose prose-lg max-w-none
      prose-headings:font-serif prose-headings:font-medium prose-headings:text-graphite
      prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4
      prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-graphite/85 prose-p:leading-relaxed
      prose-a:text-sage-700 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-graphite
      prose-blockquote:border-sage-500 prose-blockquote:text-graphite
      prose-li:marker:text-sage-500
    ">
      <slot />
    </div>

    <aside class="mt-16 p-6 sm:p-8 rounded-2xl bg-sage-50 flex flex-col gap-3">
      <p class="text-graphite/80 leading-relaxed">
        Если хочешь обсудить эту тему лично — напиши, я отвечу.
      </p>
      <div class="self-start">
        <TgButton
          message="Здравствуйте, Кристина! Хочу записаться на консультацию."
          label="Написать в Telegram"
        />
      </div>
    </aside>
  </article>

  {related.length > 0 && (
    <section class="w-full px-4 sm:px-8 py-12 sm:py-16 bg-sage-50 border-t border-sage-100">
      <div class="max-w-3xl mx-auto flex flex-col gap-8">
        <header class="flex flex-col gap-2">
          <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Похожее по теме</p>
          <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
            Если зашло — почитай ещё
          </h2>
        </header>

        <div class="grid gap-4 sm:grid-cols-2">
          {related.map((r) => {
            const rTopic = r.data.topic ? TOPIC_LABELS[r.data.topic] : null;
            return (
              <a
                href={`/articles/${r.id}/`}
                class="group flex flex-col gap-3 p-5 sm:p-6 rounded-2xl bg-cream border border-sage-100 hover:border-sage-300 transition-colors duration-200 cursor-pointer"
              >
                <div class="flex items-center gap-2 text-xs text-graphite-muted">
                  {rTopic && (
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-sage-100 text-sage-800 tracking-[0.12em] uppercase font-medium text-[10px]">
                      {rTopic}
                    </span>
                  )}
                  <time datetime={r.data.pubDate.toISOString()}>
                    {formatDateShort(r.data.pubDate)}
                  </time>
                </div>
                <h3 class="font-serif text-lg sm:text-xl text-graphite font-medium leading-tight group-hover:text-sage-800 transition-colors duration-200">
                  {r.data.title}
                </h3>
                <p class="text-sm text-graphite/75 leading-relaxed">{r.data.description}</p>
                <span class="inline-flex items-center gap-1 text-sm text-sage-700 font-medium mt-1">
                  Читать
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
