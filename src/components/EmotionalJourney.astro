---
// Эмоциональная карта пути (CJM из исследования) — 10 шагов с интенсивностью переживаний.
// Линия меняет цвет на 6-м шаге (первая встреча с психологом) — accent -> sage,
// символически: «до» одна / «после» с поддержкой.

type Step = {
  n: number;
  intensity: number; // 0–10
  duration: string;
  title: string;
  body: string;
};

const steps: Step[] = [
  {
    n: 1,
    intensity: 3,
    duration: "несколько недель – месяцев",
    title: "«Я справляюсь, просто нужно больше информации»",
    body: "Беременность идёт «нормально», но я держусь на контроле и чтении. Перебираю статьи, собираю списки, обсуждаю с подругами, откладываю помощь «на потом».",
  },
  {
    n: 2,
    intensity: 8,
    duration: "1–3 дня",
    title: "«После очередного \"накрыло\" я понимаю: так дальше нельзя»",
    body: "Вечерний эпизод тревоги или несколько ночей подряд с плохим сном. Что-то ломается в установке «я сама справлюсь».",
  },
  {
    n: 3,
    intensity: 6,
    duration: "1–4 дня",
    title: "«Я открыла 5 страниц психологов — у всех красиво, но непонятно, кто \"мой\"»",
    body: "Перебираю сайты, читаю про методы, сравниваю цены. Боюсь ошибиться и не понимаю, по чему вообще выбирать.",
  },
  {
    n: 4,
    intensity: 7,
    duration: "1–2 дня",
    title: "«Я проверяю, не будут ли меня \"лечить\" и стыдить»",
    body: "Переписка или короткий созвон-знакомство. Тестирую тон, реакцию на мои страхи, готовность работать с «не такой как все».",
  },
  {
    n: 5,
    intensity: 6,
    duration: "10–30 минут",
    title: "«А вдруг это было зря?»",
    body: "Оплачиваю — и ловлю острую мысль «а если не поможет». Самый уязвимый момент: между решением и первой встречей.",
  },
  {
    n: 6,
    intensity: 8,
    duration: "50–60 минут",
    title: "Первая встреча: можно ли здесь быть живой и неидеальной",
    body: "Проверяю, не стыдят ли меня, можно ли говорить про страхи прямо. Если можно — расслабляюсь, и начинается настоящая работа.",
  },
  {
    n: 7,
    intensity: 6,
    duration: "5–10 дней",
    title: "Первая неделя: я тестирую техники в реальной жизни",
    body: "Пробую дыхание, фразы-якоря, заземление. Срываюсь на старые привычки. Думаю «у меня не получается». Это нормально.",
  },
  {
    n: 8,
    intensity: 4,
    duration: "1–3 недели",
    title: "Мы собираем «план родов» и поддержку вокруг меня",
    body: "Вторая–третья встреча. Появляется ощущение опоры — у меня есть план, я понимаю, что делать на каждом этапе. Тревога заметно снижается.",
  },
  {
    n: 9,
    intensity: 7,
    duration: "3–10 дней",
    title: "За неделю до срока: я снова ловлю волну тревоги",
    body: "Гормоны, ожидание, бессонница. Но теперь у меня есть инструменты — я умею с этой волной обходиться, а не тонуть в ней.",
  },
  {
    n: 10,
    intensity: 6,
    duration: "1–8 недель",
    title: "После родов: я рассказываю подруге, что мне помогло",
    body: "Возвращаюсь к жизни уже мамой. Беру поддержку на следующий этап — послеродовой. Делюсь с подругой, что сработало.",
  },
];

// Геометрия SVG
const W = 1000;
const H = 320;
const PAD_X = 50;
const PAD_Y_TOP = 30;
const PAD_Y_BOTTOM = 50;
const INNER_H = H - PAD_Y_TOP - PAD_Y_BOTTOM; // 240
const INNER_W = W - PAD_X * 2; // 900

// X-координата для i-го шага (равномерно от PAD_X до W - PAD_X)
function xAt(i: number): number {
  return PAD_X + (i / (steps.length - 1)) * INNER_W;
}

// Y по интенсивности (0 внизу, 10 вверху)
function yAt(intensity: number): number {
  return PAD_Y_TOP + (1 - intensity / 10) * INNER_H;
}

// Точки в декартовых координатах
const points = steps.map((s, i) => ({
  x: xAt(i),
  y: yAt(s.intensity),
  intensity: s.intensity,
  step: s,
}));

// Сегмент кривой через Catmull-Rom → cubic Bezier
function buildSmoothPath(pts: { x: number; y: number }[], tension = 0.5): string {
  if (pts.length === 0) return "";
  if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;

  const cmds: string[] = [`M ${pts[0].x.toFixed(2)} ${pts[0].y.toFixed(2)}`];

  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? pts[i + 1];

    const cp1x = p1.x + ((p2.x - p0.x) / 6) * tension;
    const cp1y = p1.y + ((p2.y - p0.y) / 6) * tension;
    const cp2x = p2.x - ((p3.x - p1.x) / 6) * tension;
    const cp2y = p2.y - ((p3.y - p1.y) / 6) * tension;

    cmds.push(
      `C ${cp1x.toFixed(2)} ${cp1y.toFixed(2)}, ${cp2x.toFixed(2)} ${cp2y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`,
    );
  }
  return cmds.join(" ");
}

// Делим путь на два сегмента: до шага 6 (одна) и от 6 (с поддержкой)
const splitIndex = 5; // 6-й шаг (индекс 5) — переломная точка
const before = points.slice(0, splitIndex + 1);
const after = points.slice(splitIndex);

const pathBefore = buildSmoothPath(before);
const pathAfter = buildSmoothPath(after);

const colorBefore = "#C8A97E"; // accent (одна, бежевый)
const colorAfter = "#88A37D"; // sage (с поддержкой)
---

<section class="w-full px-4 sm:px-8 py-16 sm:py-24 bg-cream">
  <div class="max-w-6xl mx-auto flex flex-col gap-10 sm:gap-12">
    <header class="flex flex-col gap-3 max-w-2xl">
      <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Узнаёшь себя?</p>
      <h2 class="font-serif text-3xl sm:text-4xl text-graphite font-medium leading-tight">
        Путь от «я справлюсь сама» до «у меня есть инструменты»
      </h2>
      <p class="text-graphite/75 leading-relaxed">
        Так выглядит дорога большинства моих клиенток. Десять шагов и волна переживаний на каждом.
        Нажми на любую точку — расскажу, что происходит на этом этапе.
      </p>
    </header>

    <div
      class="emotional-journey flex flex-col gap-8 p-5 sm:p-8 rounded-3xl bg-sage-50 border border-sage-100"
      data-journey
    >
      <!-- График -->
      <div class="w-full overflow-x-auto -mx-2 px-2">
        <svg
          viewBox={`0 0 ${W} ${H}`}
          preserveAspectRatio="xMidYMid meet"
          class="w-full h-auto min-w-[600px]"
          role="img"
          aria-label="Эмоциональная карта пути из 10 шагов"
        >
          <defs>
            <!-- Лёгкое свечение под точками -->
            <filter id="dot-shadow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="2"></feGaussianBlur>
              <feOffset dx="0" dy="1" result="offset"></feOffset>
              <feComponentTransfer><feFuncA type="linear" slope="0.25"></feFuncA></feComponentTransfer>
              <feMerge><feMergeNode></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
            </filter>
          </defs>

          <!-- Сетка / горизонтальные линии -->
          {[0, 2, 4, 6, 8, 10].map((level) => (
            <g>
              <line
                x1={PAD_X}
                y1={yAt(level)}
                x2={W - PAD_X}
                y2={yAt(level)}
                stroke="#E3EBE0"
                stroke-width="1"
                stroke-dasharray="2 4"
              />
              <text
                x={PAD_X - 12}
                y={yAt(level) + 4}
                text-anchor="end"
                font-family="Inter, system-ui, sans-serif"
                font-size="11"
                fill="#6B6B66"
              >
                {level}
              </text>
            </g>
          ))}

          <!-- Заливка под кривой (мягкая) -->
          <path
            d={`${pathBefore} L ${after[after.length - 1].x} ${H - PAD_Y_BOTTOM} L ${PAD_X} ${H - PAD_Y_BOTTOM} Z`}
            fill={colorBefore}
            fill-opacity="0.08"
          />
          <path
            d={`${pathAfter} L ${after[after.length - 1].x} ${H - PAD_Y_BOTTOM} L ${after[0].x} ${H - PAD_Y_BOTTOM} Z`}
            fill={colorAfter}
            fill-opacity="0.10"
          />

          <!-- Линии -->
          <path d={pathBefore} fill="none" stroke={colorBefore} stroke-width="3" stroke-linecap="round" />
          <path d={pathAfter} fill="none" stroke={colorAfter} stroke-width="3" stroke-linecap="round" />

          <!-- Точки -->
          {points.map((p, i) => (
            <g
              class="journey-point cursor-pointer"
              data-step-index={i}
              tabindex="0"
              role="button"
              aria-label={`Шаг ${p.step.n}: ${p.step.title}. Интенсивность ${p.intensity} из 10.`}
            >
              <!-- Невидимая увеличенная hit-area для тача -->
              <circle cx={p.x} cy={p.y} r="22" fill="transparent" />
              <!-- Видимая точка -->
              <circle
                class="journey-dot"
                cx={p.x}
                cy={p.y}
                r="7"
                fill="#FAF7F1"
                stroke={i <= splitIndex ? colorBefore : colorAfter}
                stroke-width="3"
                filter="url(#dot-shadow)"
              />
              <!-- Подпись «Шаг N» под точкой -->
              <text
                class="journey-label"
                x={p.x}
                y={H - PAD_Y_BOTTOM + 22}
                text-anchor="middle"
                font-family="Inter, system-ui, sans-serif"
                font-size="12"
                font-weight="500"
                fill="#6B6B66"
              >
                {`Шаг ${p.step.n}`}
              </text>
            </g>
          ))}
        </svg>
      </div>

      <!-- Карточка с описанием активного шага -->
      <article
        id="journey-card"
        class="flex flex-col gap-3 p-5 sm:p-7 rounded-2xl bg-cream border border-sage-100"
      >
        <div class="flex items-baseline gap-3 flex-wrap">
          <span
            id="journey-step-num"
            class="font-serif text-3xl sm:text-4xl text-sage-700 font-medium leading-none"
          >
            1
          </span>
          <p
            id="journey-duration"
            class="text-xs tracking-[0.14em] uppercase text-graphite-muted font-medium"
          >
            {steps[0].duration}
          </p>
          <p id="journey-intensity" class="text-xs text-graphite-muted ml-auto">
            Интенсивность: <span id="journey-intensity-val" class="font-medium text-graphite/80">{steps[0].intensity}</span>/10
          </p>
        </div>
        <h3
          id="journey-title"
          class="font-serif text-xl sm:text-2xl text-graphite font-medium leading-tight"
        >
          {steps[0].title}
        </h3>
        <p id="journey-body" class="text-graphite/85 leading-relaxed">
          {steps[0].body}
        </p>
      </article>

      <!-- Навигация по шагам и легенда -->
      <div class="flex items-center justify-between gap-3 flex-wrap text-xs text-graphite-muted">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-3 h-0.5 rounded-full" style={`background:${colorBefore}`}></span>
            «Сама»
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-3 h-0.5 rounded-full" style={`background:${colorAfter}`}></span>
            «Вместе»
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="journey-prev"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-sage-200 bg-cream hover:bg-sage-50 text-graphite/70 hover:text-graphite transition-colors duration-200 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Предыдущий шаг"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            id="journey-next"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-sage-200 bg-cream hover:bg-sage-50 text-graphite/70 hover:text-graphite transition-colors duration-200 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Следующий шаг"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <p class="text-sm text-graphite/65 max-w-3xl leading-relaxed">
      Этот путь — не сценарий, а карта. Можно прийти ко мне в любой точке.
      Если ты сейчас на шагах 1–3 — начни с <a href="#cards" class="text-sage-700 underline hover:text-sage-800">бесплатных карточек</a>.
      На шагах 4 и дальше — <a href="https://t.me/Kris_tellme" target="_blank" rel="noopener" class="text-sage-700 underline hover:text-sage-800">напиши мне в Telegram</a>, расскажу, как могу поддержать.
    </p>
  </div>
</section>

<script is:inline define:vars={{ stepsData: steps }}>
  (function () {
    const data = stepsData;
    const root = document.querySelector("[data-journey]");
    if (!root) return;

    const dots = root.querySelectorAll(".journey-point");
    const numEl = document.getElementById("journey-step-num");
    const durEl = document.getElementById("journey-duration");
    const intEl = document.getElementById("journey-intensity-val");
    const titleEl = document.getElementById("journey-title");
    const bodyEl = document.getElementById("journey-body");
    const prevBtn = document.getElementById("journey-prev");
    const nextBtn = document.getElementById("journey-next");

    let activeIndex = 0;

    function select(index) {
      if (index < 0 || index >= data.length) return;
      activeIndex = index;
      const step = data[index];

      if (numEl) numEl.textContent = String(step.n);
      if (durEl) durEl.textContent = step.duration;
      if (intEl) intEl.textContent = String(step.intensity);
      if (titleEl) titleEl.textContent = step.title;
      if (bodyEl) bodyEl.textContent = step.body;

      dots.forEach((g, i) => {
        const dot = g.querySelector(".journey-dot");
        const label = g.querySelector(".journey-label");
        if (!dot || !label) return;
        if (i === index) {
          dot.setAttribute("r", "10");
          dot.setAttribute("fill", i <= 5 ? "#C8A97E" : "#88A37D");
          label.setAttribute("fill", "#2A2A28");
          label.setAttribute("font-weight", "600");
        } else {
          dot.setAttribute("r", "7");
          dot.setAttribute("fill", "#FAF7F1");
          label.setAttribute("fill", "#6B6B66");
          label.setAttribute("font-weight", "500");
        }
      });

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === data.length - 1;
    }

    dots.forEach((g) => {
      const handler = () => {
        const idx = Number(g.getAttribute("data-step-index"));
        select(idx);
      };
      g.addEventListener("click", handler);
      g.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          handler();
        }
      });
    });

    prevBtn?.addEventListener("click", () => select(activeIndex - 1));
    nextBtn?.addEventListener("click", () => select(activeIndex + 1));

    select(0);
  })();
</script>

<style>
  .journey-point {
    transition: transform 200ms ease;
  }
  .journey-point:hover .journey-dot,
  .journey-point:focus-visible .journey-dot {
    r: 10;
  }
  .journey-point:focus-visible {
    outline: none;
  }
  .journey-point:focus-visible .journey-dot {
    stroke-width: 4;
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-point {
      transition: none;
    }
  }
</style>
