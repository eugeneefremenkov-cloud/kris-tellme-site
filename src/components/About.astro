---
import { Image } from "astro:assets";
import { BRAND } from "../lib/constants";
import kristinaAbout from "../assets/images/kristina-about.jpg";

const credentials = [
  "Среднее медицинское и высшее психологическое образование",
  "5 лет частной практики",
  "Методы: КПТ, схема-терапия, метафорические карты, телесная терапия",
  "Личная терапия, супервизии, повышение квалификации по перинатальному профилю",
];
---

<section id="about" class="w-full px-4 sm:px-8 py-16 sm:py-24 bg-sage-50">
  <div class="max-w-6xl mx-auto grid gap-10 sm:gap-16 sm:grid-cols-[1fr_1.4fr] sm:items-center">
    <Image
      src={kristinaAbout}
      alt={BRAND.fullName}
      widths={[400, 600, 800]}
      sizes="(min-width: 640px) 40vw, 100vw"
      format="webp"
      quality={82}
      loading="lazy"
      class="w-full aspect-[3/4] object-cover object-top rounded-2xl shadow-[var(--shadow-soft)]"
    />

    <div class="flex flex-col gap-6">
      <h2 class="font-serif text-3xl sm:text-4xl text-graphite font-medium leading-tight">
        Кристина Ефременкова
      </h2>
      <p class="text-lg text-graphite/85 leading-relaxed">
        Перинатальный психолог. Сопровождаю женщин на пути к материнству — от тревог беременности до адаптации после родов. Считаю, что страх перед родами — это нормально, и с ним можно жить мягче.
      </p>

      <ul class="flex flex-col gap-3 text-graphite/80">
        {credentials.map((line) => (
          <li class="flex gap-3 leading-relaxed">
            <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-sage-500 flex-shrink-0"></span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
