---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SERVICES, PROGRAMS, CONTACT } from "../lib/constants";

const forYouIf = [
  "к концу беременности всё чаще накручиваешь сценарии и не можешь остановиться",
  "родственники забирают пространство советами и «как было правильно у них»",
  "партнёр не понимает твою тревогу, и это усиливает напряжение",
  "после первого ребёнка хочешь подготовиться по-другому",
  "ты в декрете и не узнаёшь себя — устала, раздражена, винишь себя",
  "долго не получается забеременеть, и каждый цикл — стресс",
];

// Селектор аудитории: 5 опций → какой формат рекомендован
const audienceOptions = [
  { id: "planning", label: "Планирую", target: "consultation", note: "На этом этапе обычно нужна точечная работа с одним вопросом или страхом. Программа пока избыточна." },
  { id: "early", label: "1–19 недель", target: "consultation", note: "Ранняя беременность: чаще нужна разовая поддержка по конкретной ситуации. Программу подключают ближе к 20-й неделе." },
  { id: "mid", label: "20–36 недель", target: "prenatal", note: "Оптимальный момент для системной подготовки. У тебя есть 4 недели — идеально под программу." },
  { id: "late", label: "37–40 недель", target: "prenatal", note: "До родов осталось мало времени. Можно успеть короткий формат программы или начать с разовой встречи." },
  { id: "postpartum", label: "После родов", target: "postnatal", note: "Первые недели и месяцы — самые уязвимые. Программа поможет пройти их устойчиво." },
];

const prenatalMeetings = [
  {
    n: 1,
    title: "Карта тревог + первая опора",
    body: "Разбираем твои конкретные страхи: что именно пугает, что триггерит, как ты сейчас справляешься. Объясняю, что норма, а что стоит проработать.",
    outcome: "Персональный план на 14 дней + 2 техники саморегуляции (дыхание 4-7-8 и заземление 5-4-3-2-1).",
  },
  {
    n: 2,
    title: "Тело и роды: мифы vs реальность",
    body: "Что реально происходит с телом в родах. Работа со страхом боли и страхом потери контроля. Образ боли как «волны», которая ведёт к малышу.",
    outcome: "Техника визуализации родов + 2–3 фразы-якоря под твою историю.",
  },
  {
    n: 3,
    title: "Окружение и план родов",
    body: "Кто будет рядом и как с ними договориться: партнёр, мама, врач. Учимся говорить «нет» и выставлять границы — до родов и после.",
    outcome: "Персональный «план родов» на бумаге + сценарии разговоров с близкими.",
  },
  {
    n: 4,
    title: "Финальная сборка + послеродовая подготовка",
    body: "Что брать «психологически» в роддом. Первые недели после родов: что нормально, как себя поддержать, когда обращаться за помощью.",
    outcome: "Финальная карта опор + recap всех инструментов программы.",
  },
];

const postnatalMeetings = [
  {
    n: 1,
    title: "Первые недели: что нормально",
    body: "Слёзы по пустякам, чувство вины, провалы в памяти, страх «я не справляюсь» — что из этого норма послеродового периода, а что сигнал обратиться за помощью. Разбираем твою конкретную ситуацию.",
    outcome: "Карта своего состояния + чек-лист «когда сразу к врачу» + 2 техники самопомощи.",
  },
  {
    n: 2,
    title: "Тело, сон, восстановление",
    body: "Психология вокруг физического восстановления: как договариваться с собой о темпе, что делать с раздражением от недосыпа, как не сравнивать своё тело с инстаграмом.",
    outcome: "Личная стратегия сна и отдыха в твоих условиях + работа с виной за «себя».",
  },
  {
    n: 3,
    title: "Отношения и идентичность",
    body: "«Я больше не та, что была» — как пройти этот переход без чувства потери. Что меняется с партнёром, с родителями, с подругами. Что делать, если хочется обратно «до».",
    outcome: "Сценарии трудных разговоров (с партнёром, с роднёй) + опоры в новой идентичности.",
  },
  {
    n: 4,
    title: "Новый ритм жизни",
    body: "Возвращение к работе, социализация, дружба, как находить минуты для себя. Сборка всех инструментов в систему, которая работает в твоей реальной жизни — без идеала.",
    outcome: "Карта твоих опор на ближайшие 3 месяца + recap всех техник программы.",
  },
];

const process = [
  { n: 1, title: "Пиши в Telegram", text: "Короткое сообщение — что хочешь обсудить, на каком сроке ты сейчас или сколько времени после родов." },
  { n: 2, title: "Я отвечу в течение дня", text: "Согласуем формат и тариф. Если сомневаешься — задай вопросы заранее, я подскажу, что подойдёт." },
  { n: 3, title: "Оплата и подтверждение", text: "Перевод на карту. Для видео-тарифов сразу пришлю ссылку на закрытый плейлист. Для персонального — план встреч и Zoom-ссылку." },
  { n: 4, title: "Работа", text: "Видео можно смотреть в своём темпе. Живые встречи — раз в неделю по 50 минут. Между ними — практики и переписка." },
  { n: 5, title: "Материалы после", text: "После каждой встречи — recap и план в Telegram. После всей программы — финальная карта опор." },
];

const directions = [
  { title: "Беременность", text: "Тревога перед родами, страх боли, конфликты с близкими из-за беременности, подготовка к встрече с малышом." },
  { title: "Послеродовой период", text: "Адаптация в первые месяцы, раздражительность, чувство вины, дефицит сна, потеря «себя»." },
  { title: "Планирование", text: "Поддержка при длительных попытках забеременеть, в период диагностики и обследований." },
];

const methods = [
  { title: "КПТ", text: "Когнитивно-поведенческая терапия — работа с автоматическими мыслями и катастрофизацией." },
  { title: "Схема-терапия", text: "Глубже про устойчивые паттерны — что заставляет тебя реагировать так, как реагируешь." },
  { title: "МАК (метафорические карты)", text: "Для доступа к чувствам, когда слова не находятся. Работает как мостик от тела к словам." },
  { title: "Телесная терапия", text: "Для работы со страхом боли, дыханием, заземлением. Тело — наш союзник в родах." },
];

const conditions = [
  { title: "Конфиденциальность", text: "Всё, что ты говоришь на встрече, остаётся между нами. Я не публикую истории клиентов даже анонимно без явного согласия." },
  { title: "Доступ к видео", text: "После оплаты самостоятельного тарифа я присылаю ссылку на закрытый YouTube-плейлист и PDF-материалы. Доступ — навсегда." },
  { title: "Отмена и перенос", text: "Живые встречи можно отменить или перенести бесплатно за 24 часа. Если случилось срочное в день встречи (роды начались) — переносим без вопросов." },
  { title: "Оплата", text: "Перевод на карту. Персональный тариф программы можно оплатить полностью или 50/50 (перед 1-й и перед 3-й встречей)." },
];

const faq = [
  {
    q: "Что значит «предзаказ» у самостоятельного тарифа?",
    a: "Сейчас я записываю видео-курсы для обеих программ. Старт — июль 2026. До этого момента можно купить курс по цене предзаказа (3 900 ₽ вместо 5 900 ₽). Доступ к плейлисту откроется в день старта, и я уведомлю каждого, кто оплатил. Если в день старта передумаешь — верну деньги без вопросов.",
  },
  {
    q: "Чем самостоятельный тариф отличается от персонального?",
    a: "Самостоятельный — это видео-курс, который ты смотришь в своём темпе, плюс рабочая тетрадь с упражнениями. Подходит, если бюджет ограничен или хочется сначала «попробовать на себе». Персональный тариф = тот же видео-курс + 4 живые встречи со мной, индивидуальный план под твою историю и безлимитная переписка. Подходит, когда тревога сильная и хочется поддержки рядом.",
  },
  {
    q: "Можно ли перейти с самостоятельного на персональный?",
    a: "Да. Если начала с видео и поняла, что хочешь личной работы — пиши, и я зачту стоимость самостоятельного тарифа в оплату персонального. Доплата 12 000 ₽.",
  },
  {
    q: "Что если я просто хочу разовый разговор?",
    a: "Тогда выбирай разовую консультацию (4 900 ₽ / 50 минут). Это формат для точечного запроса: один вопрос, один разговор. Без обязательств продолжать.",
  },
  {
    q: "Чем перинатальный психолог отличается от обычного?",
    a: "Перинатальный психолог работает только с темой родительства: беременность, роды, послеродовое, планирование. Я знаю физиологию беременности, понимаю, что нормально на каком сроке, и не «лечу» гормональные перепады.",
  },
  {
    q: "А если онлайн «не настоящее»?",
    a: "Онлайн-формат — основной для перинатальной работы. Ты не выходишь из дома, нет дороги, нет тревоги по поводу транспорта. Качество разговора то же. Если после первой встречи понимаешь, что не «твоё» — возвращаю деньги за неиспользованные встречи.",
  },
  {
    q: "Вы будете против моих решений (партнёрские роды, выбор роддома)?",
    a: "Нет. Я не выбираю за тебя — помогаю принять решение осознанно, понимая свои страхи и желания. Твои выборы — твои.",
  },
  {
    q: "А если я не смогу выполнять практики между встречами?",
    a: "Это тоже информация. Если не получается — обсудим почему. Я не оцениваю — помогаю настроить процесс под твою реальную жизнь.",
  },
  {
    q: "Откуда я знаю, что вы умеете работать с беременными и мамами?",
    a: "Среднее медицинское и высшее психологическое образование, 5 лет частной практики, повышение квалификации по перинатальному профилю. На главной сайта есть 3 бесплатные копинг-карточки — посмотри тон и подход. Если откликается, мы найдём общий язык.",
  },
];

const heroFacts = [
  { label: "Что получишь", value: "Видео-курс или 4 живые встречи с персональным планом" },
  { label: "Как", value: "Онлайн: видео в своём темпе или Zoom/Телемост по расписанию" },
  { label: "Метод", value: "КПТ, схема-терапия, МАК. Без эзотерики и обещаний" },
  { label: "Безопасно", value: "Правила конфиденциальности прописаны заранее" },
];

const programs = [PROGRAMS.prenatal, PROGRAMS.postnatal];
---

<BaseLayout
  title="Услуги — КРИС, СКАЖИ МНЕ"
  description="Программа подготовки к родам, сопровождение после родов и разовые консультации. Видео-курс или личная работа с Кристиной Ефременковой. Онлайн по всей России."
>
  <!-- HERO -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20">
    <div class="max-w-6xl mx-auto flex flex-col gap-12">
      <header class="flex flex-col gap-4 max-w-3xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Услуги</p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-graphite font-medium leading-tight">
          Помогу пройти беременность, роды и первый год материнства без паники
        </h1>
        <p class="text-lg text-graphite/80 leading-relaxed">
          Перинатальный психолог. Работаю с тревогой и страхами при беременности, после родов и при
          планировании. Онлайн по всей России — видео-курс или живые встречи в Zoom/Телемост.
        </p>
      </header>

      <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {heroFacts.map((fact) => (
          <div class="flex flex-col gap-2 p-5 rounded-2xl bg-sage-50 border border-sage-100">
            <p class="text-xs tracking-[0.14em] uppercase text-sage-700 font-medium">{fact.label}</p>
            <p class="text-sm text-graphite/85 leading-relaxed">{fact.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- СЕЛЕКТОР АУДИТОРИИ -->
  <section class="w-full px-4 sm:px-8 py-10 sm:py-14 bg-cream-deep border-y border-sage-100">
    <div class="max-w-6xl mx-auto flex flex-col gap-6" data-audience-selector>
      <header class="flex flex-col gap-2 max-w-2xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Подбор формата</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          На каком ты сейчас этапе?
        </h2>
        <p class="text-graphite/75 leading-relaxed">
          Выбери и я подсвечу формат, который скорее всего подходит под твою ситуацию.
        </p>
      </header>

      <div class="flex flex-wrap gap-2">
        {audienceOptions.map((opt) => (
          <button
            type="button"
            class="audience-btn px-4 py-2.5 rounded-full text-sm font-medium border border-sage-200 bg-cream text-graphite/85 hover:bg-sage-50 hover:border-sage-300 transition-colors duration-200 cursor-pointer data-[active=true]:bg-sage-700 data-[active=true]:text-cream data-[active=true]:border-sage-700"
            data-audience-id={opt.id}
            data-audience-target={opt.target}
            data-audience-note={opt.note}
          >
            {opt.label}
          </button>
        ))}
      </div>

      <p
        id="audience-note"
        class="hidden text-sm text-graphite/80 leading-relaxed p-4 rounded-2xl bg-sage-50 border border-sage-100 max-w-3xl"
      ></p>
    </div>
  </section>

  <!-- ЭТО ДЛЯ ТЕБЯ, ЕСЛИ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-16 bg-sage-50">
    <div class="max-w-3xl mx-auto flex flex-col gap-8">
      <header class="flex flex-col gap-2">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Кому подойдёт</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Это для тебя, если…
        </h2>
      </header>
      <ul class="flex flex-col gap-3 text-graphite/85 leading-relaxed">
        {forYouIf.map((line) => (
          <li class="flex gap-3">
            <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-sage-500 flex-shrink-0"></span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ФОРМАТЫ РАБОТЫ -->
  <section class="w-full px-4 sm:px-8 py-16 sm:py-24">
    <div class="max-w-6xl mx-auto flex flex-col gap-12">
      <header class="flex flex-col gap-3 max-w-2xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Форматы работы</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Две программы и разовая консультация
        </h2>
      </header>

      <div class="grid gap-6 lg:grid-cols-3 lg:items-stretch">
        {programs.map((program) => (
          <article
            data-format-card={program.slug}
            class="format-card relative flex flex-col gap-5 p-6 sm:p-7 rounded-3xl bg-cream-deep border border-sage-100 transition-all duration-300"
          >
            <span
              class="recommended-badge hidden absolute -top-3 left-6 text-[10px] tracking-[0.18em] uppercase font-medium px-3 py-1 rounded-full bg-sage-700 text-cream shadow-[var(--shadow-soft)]"
            >
              Рекомендуем
            </span>

            <header class="flex flex-col gap-1.5">
              <p class="text-xs tracking-[0.14em] uppercase text-sage-700 font-medium">{program.audienceLabel}</p>
              <h3 class="font-serif text-2xl text-graphite font-medium leading-tight">{program.title}</h3>
            </header>

            <p class="text-sm text-graphite/80 leading-relaxed">{program.description}</p>

            <!-- Tariff tabs -->
            <div class="flex p-1 rounded-full bg-cream border border-sage-100" role="tablist">
              <button
                type="button"
                class="tariff-tab flex-1 px-3 py-2 rounded-full text-xs font-medium text-graphite/70 hover:text-graphite transition-colors duration-200 cursor-pointer data-[active=true]:bg-sage-700 data-[active=true]:text-cream"
                data-tariff="self"
                data-active="true"
                aria-label="Тариф самостоятельный"
              >
                {program.self.label}
              </button>
              <button
                type="button"
                class="tariff-tab flex-1 px-3 py-2 rounded-full text-xs font-medium text-graphite/70 hover:text-graphite transition-colors duration-200 cursor-pointer data-[active=true]:bg-sage-700 data-[active=true]:text-cream"
                data-tariff="personal"
                aria-label="Тариф персональный"
              >
                {program.personal.label}
              </button>
            </div>

            <!-- Self tariff content -->
            <div data-tariff-content="self" class="flex flex-col gap-4 flex-1">
              {program.self.preorder?.active ? (
                <>
                  <div class="flex flex-col gap-1.5">
                    <span class="self-start text-[10px] tracking-[0.18em] uppercase font-medium px-2.5 py-1 rounded-full bg-accent/15 text-accent-deep">
                      Предзаказ
                    </span>
                    <div class="flex items-baseline gap-2">
                      <p class="font-serif text-3xl text-sage-800 font-medium">{program.self.preorder.price}</p>
                      <p class="text-sm text-graphite-muted line-through">{program.self.price}</p>
                    </div>
                    <p class="text-xs text-graphite/65 leading-relaxed">{program.self.preorder.note}</p>
                  </div>
                </>
              ) : (
                <div class="flex items-baseline gap-2">
                  <p class="font-serif text-3xl text-sage-800 font-medium">{program.self.price}</p>
                  <p class="text-sm text-graphite-muted">{program.self.pricePer}</p>
                </div>
              )}

              <ul class="flex flex-col gap-2 text-sm text-graphite/80 leading-relaxed flex-1">
                {program.self.includes.map((line) => (
                  <li class="flex gap-2">
                    <svg class="w-4 h-4 mt-0.5 text-sage-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
              <a
                href={`${CONTACT.telegramLink}?text=${encodeURIComponent(
                  program.self.preorder?.active ? program.self.preorder.tgMessage : program.self.tgMessage,
                )}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center gap-2 self-start mt-2 px-5 py-3 rounded-full bg-sage-700 text-cream hover:bg-sage-800 transition-colors duration-200 cursor-pointer font-medium text-sm"
              >
                {program.self.preorder?.active ? "Забронировать предзаказ" : "Записаться"}
              </a>
            </div>

            <!-- Personal tariff content -->
            <div data-tariff-content="personal" class="hidden flex-col gap-4 flex-1">
              <div class="flex items-baseline gap-2">
                <p class="font-serif text-3xl text-sage-800 font-medium">{program.personal.price}</p>
                <p class="text-sm text-graphite-muted">{program.personal.pricePer}</p>
              </div>
              <ul class="flex flex-col gap-2 text-sm text-graphite/80 leading-relaxed flex-1">
                {program.personal.includes.map((line) => (
