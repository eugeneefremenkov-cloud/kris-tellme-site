---
import BaseLayout from "../layouts/BaseLayout.astro";
import TgButton from "../components/TgButton.astro";
import { SERVICES, CONTACT } from "../lib/constants";

const forYouIf = [
  "к концу беременности всё чаще накручиваешь сценарии и не можешь остановиться",
  "родственники забирают пространство советами и «как было правильно у них»",
  "партнёр не понимает твою тревогу, и это усиливает напряжение",
  "после первого ребёнка хочешь подготовиться по-другому",
  "ты в декрете и не узнаёшь себя — устала, раздражена, винишь себя",
  "долго не получается забеременеть, и каждый цикл — стресс",
];

const programMeetings = [
  {
    n: 1,
    title: "Карта тревог + первая опора",
    body: "Разбираем твои конкретные страхи: что именно пугает, что триггерит, как ты сейчас справляешься. Объясняю, что норма, а что стоит проработать.",
    outcome: "Персональный план на 14 дней + 2 техники саморегуляции (дыхание 4-7-8 и заземление 5-4-3-2-1).",
  },
  {
    n: 2,
    title: "Тело и роды: мифы vs реальность",
    body: "Что реально происходит с телом в родах. Работа со страхом боли и страхом потери контроля. Образ боли как «волны», которая ведёт к малышу.",
    outcome: "Техника визуализации родов + 2–3 фразы-якоря под твою историю.",
  },
  {
    n: 3,
    title: "Окружение и план родов",
    body: "Кто будет рядом и как с ними договориться: партнёр, мама, врач. Учимся говорить «нет» и выставлять границы — до родов и после.",
    outcome: "Персональный «план родов» на бумаге + сценарии разговоров с близкими.",
  },
  {
    n: 4,
    title: "Финальная сборка + послеродовая подготовка",
    body: "Что брать «психологически» в роддом. Первые недели после родов: что нормально, как себя поддержать, когда обращаться за помощью.",
    outcome: "Финальная карта опор + recap всех инструментов программы.",
  },
];

const process = [
  {
    n: 1,
    title: "Пиши в Telegram",
    text: "Короткое сообщение — что хочешь обсудить, на каком сроке ты сейчас.",
  },
  {
    n: 2,
    title: "Я отвечу в течение дня",
    text: "Согласуем формат, удобное время. Если сомневаешься — задай вопросы заранее.",
  },
  {
    n: 3,
    title: "Оплата и подтверждение",
    text: "Перевод на карту. Получишь ссылку Zoom или Телемост и короткую анкету.",
  },
  {
    n: 4,
    title: "Встреча",
    text: "50 минут. Видео — по желанию. Без диктофона, всё конфиденциально.",
  },
  {
    n: 5,
    title: "Материалы после",
    text: "В течение 24 часов — план, упражнения, recap встречи в Telegram.",
  },
];

const directions = [
  {
    title: "Беременность",
    text: "Тревога перед родами, страх боли, конфликты с близкими из-за беременности, подготовка к встрече с малышом.",
  },
  {
    title: "Послеродовой период",
    text: "Адаптация в первые месяцы, раздражительность, чувство вины, дефицит сна, потеря «себя».",
  },
  {
    title: "Планирование",
    text: "Поддержка при длительных попытках забеременеть, в период диагностики и обследований.",
  },
];

const methods = [
  {
    title: "КПТ",
    text: "Когнитивно-поведенческая терапия — работа с автоматическими мыслями и катастрофизацией.",
  },
  {
    title: "Схема-терапия",
    text: "Глубже про устойчивые паттерны — что заставляет тебя реагировать так, как реагируешь.",
  },
  {
    title: "МАК (метафорические карты)",
    text: "Для доступа к чувствам, когда слова не находятся. Работает как мостик от тела к словам.",
  },
  {
    title: "Телесная терапия",
    text: "Для работы со страхом боли, дыханием, заземлением. Тело — наш союзник в родах.",
  },
];

const conditions = [
  {
    title: "Конфиденциальность",
    text: "Всё, что ты говоришь на встрече, остаётся между нами. Я не публикую истории клиентов даже анонимно без явного согласия.",
  },
  {
    title: "Отмена и перенос",
    text: "Можно отменить или перенести бесплатно за 24 часа до встречи. Если случилось срочное в день встречи (роды начались) — переносим без вопросов.",
  },
  {
    title: "Технически",
    text: "Нужен смартфон или ноутбук с интернетом и наушники. Видео — по желанию.",
  },
  {
    title: "Оплата",
    text: "Перевод на карту. Программу можно оплатить полностью или 50/50 (перед 1-й и перед 3-й встречей).",
  },
];

const faq = [
  {
    q: "Чем перинатальный психолог отличается от обычного?",
    a: "Перинатальный психолог работает только с темой родительства: беременность, роды, послеродовое, планирование. Я знаю физиологию беременности, понимаю, что нормально на каком сроке, и не «лечу» гормональные перепады.",
  },
  {
    q: "Что если мне страшно начать?",
    a: "Это нормально. Если хочешь — начнём с МАК-экспресса за 500 ₽: 5 минут, я вытаскиваю карту и присылаю расшифровку голосовыми. Это лёгкий способ познакомиться без обязательств.",
  },
  {
    q: "А если онлайн «не настоящее»?",
    a: "Онлайн-формат — основной для перинатальной работы. Ты не выходишь из дома, нет дороги, нет тревоги по поводу транспорта. Качество разговора то же. Если совсем не отзывается — после первой встречи возвращаю деньги.",
  },
  {
    q: "Вы будете против моих решений (партнёрские роды, выбор роддома)?",
    a: "Нет. Я не выбираю за тебя — я помогаю принять решение осознанно, понимая свои страхи и желания. Твои выборы — твои.",
  },
  {
    q: "А если я не смогу выполнять практики между встречами?",
    a: "Это тоже информация. Если не получается — мы обсудим почему. Я не оцениваю — я помогаю настроить процесс под твою реальную жизнь.",
  },
  {
    q: "Что если мне не подойдёт ваш стиль?",
    a: "Если после первой встречи понимаешь, что не «твоё» — скажи прямо. Возвращу деньги за неиспользованные встречи программы. Один формат не подходит всем, и это нормально.",
  },
  {
    q: "Откуда я знаю, что вы умеете работать с беременными?",
    a: "Среднее медицинское и высшее психологическое образование, 5 лет частной практики, повышение квалификации по перинатальному профилю. На главной сайта есть 3 бесплатные копинг-карточки — посмотри тон и подход. Если откликается, мы найдём общий язык.",
  },
];

const heroFacts = [
  {
    label: "Что получишь",
    value: "План на 14 дней и техники саморегуляции после первой встречи",
  },
  {
    label: "Как",
    value: "Онлайн в Zoom или Телемост, ты не выходишь из дома",
  },
  {
    label: "Метод",
    value: "КПТ, схема-терапия, МАК. Без эзотерики и обещаний",
  },
  {
    label: "Безопасно",
    value: "Правила конфиденциальности прописаны заранее",
  },
];
---

<BaseLayout
  title="Услуги — КРИС, СКАЖИ МНЕ"
  description="Программа подготовки к родам, разовые консультации и МАК-экспресс. Перинатальный психолог Кристина Ефременкова. Онлайн в Zoom или Телемост."
>
  <!-- HERO -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20">
    <div class="max-w-6xl mx-auto flex flex-col gap-12">
      <header class="flex flex-col gap-4 max-w-3xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Услуги</p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-graphite font-medium leading-tight">
          Помогу пройти беременность и роды без паники
        </h1>
        <p class="text-lg text-graphite/80 leading-relaxed">
          Перинатальный психолог. Работаю с тревогой и страхами при беременности, после родов и при
          планировании. Онлайн по всей России — Zoom или Телемост.
        </p>
      </header>

      <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {heroFacts.map((fact) => (
          <div class="flex flex-col gap-2 p-5 rounded-2xl bg-sage-50 border border-sage-100">
            <p class="text-xs tracking-[0.14em] uppercase text-sage-700 font-medium">{fact.label}</p>
            <p class="text-sm text-graphite/85 leading-relaxed">{fact.value}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ЭТО ДЛЯ ТЕБЯ, ЕСЛИ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-16 bg-sage-50">
    <div class="max-w-3xl mx-auto flex flex-col gap-8">
      <header class="flex flex-col gap-2">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Кому подойдёт</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Это для тебя, если…
        </h2>
      </header>
      <ul class="flex flex-col gap-3 text-graphite/85 leading-relaxed">
        {forYouIf.map((line) => (
          <li class="flex gap-3">
            <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-sage-500 flex-shrink-0"></span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ФОРМАТЫ РАБОТЫ -->
  <section class="w-full px-4 sm:px-8 py-16 sm:py-24">
    <div class="max-w-6xl mx-auto flex flex-col gap-12">
      <header class="flex flex-col gap-3 max-w-2xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Форматы работы</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Три формата — от лёгкого знакомства до системной подготовки
        </h2>
      </header>

      <div class="grid gap-6 lg:grid-cols-3 lg:items-stretch">
        <!-- Программа — выделена -->
        <article class="relative flex flex-col gap-5 p-6 sm:p-8 rounded-3xl bg-sage-700 text-cream lg:col-span-1">
          <span class="absolute top-5 right-5 text-[10px] tracking-[0.18em] uppercase font-medium px-3 py-1 rounded-full bg-cream text-sage-800">
            Популярное
          </span>
          <div class="flex flex-col gap-1.5">
            <p class="text-xs tracking-[0.14em] uppercase text-cream/70 font-medium">{SERVICES.program.duration}</p>
            <h3 class="font-serif text-2xl text-cream font-medium leading-tight">{SERVICES.program.title}</h3>
          </div>
          <div class="flex items-baseline gap-2">
            <p class="font-serif text-3xl text-cream font-medium">{SERVICES.program.price}</p>
            <p class="text-sm text-cream/70">{SERVICES.program.pricePer}</p>
          </div>
          <p class="text-cream/90 leading-relaxed">{SERVICES.program.description}</p>

          <ul class="flex flex-col gap-2 text-sm text-cream/85 leading-relaxed border-t border-cream/20 pt-5">
            <li class="flex gap-2"><span class="mt-1.5 w-1 h-1 rounded-full bg-cream/60 flex-shrink-0"></span><span>Безлимитная переписка в Telegram/ВК всё время программы + 2 недели после</span></li>
            <li class="flex gap-2"><span class="mt-1.5 w-1 h-1 rounded-full bg-cream/60 flex-shrink-0"></span><span>Доступ к 18 копинг-карточкам по коду участницы</span></li>
            <li class="flex gap-2"><span class="mt-1.5 w-1 h-1 rounded-full bg-cream/60 flex-shrink-0"></span><span>Финальная карта опор и план родов</span></li>
          </ul>

          <a
            href={`${CONTACT.telegramLink}?text=${encodeURIComponent(SERVICES.program.tgMessage)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 self-start mt-2 px-5 py-3 rounded-full bg-cream text-sage-800 hover:bg-white transition-colors duration-200 cursor-pointer font-medium text-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Записаться на программу
          </a>
        </article>

        <!-- Консультация -->
        <article class="flex flex-col gap-5 p-6 sm:p-8 rounded-3xl bg-cream-deep border border-sage-100">
          <div class="flex flex-col gap-1.5">
            <p class="text-xs tracking-[0.14em] uppercase text-sage-700 font-medium">{SERVICES.consultation.duration}</p>
            <h3 class="font-serif text-2xl text-graphite font-medium leading-tight">{SERVICES.consultation.title}</h3>
          </div>
          <div class="flex items-baseline gap-2">
            <p class="font-serif text-3xl text-sage-800 font-medium">{SERVICES.consultation.price}</p>
            <p class="text-sm text-graphite-muted">{SERVICES.consultation.pricePer}</p>
          </div>
          <p class="text-graphite/80 leading-relaxed flex-1">{SERVICES.consultation.description}</p>

          <TgButton message={SERVICES.consultation.tgMessage} label="Записаться" />
        </article>

        <!-- МАК-экспресс -->
        <article class="flex flex-col gap-5 p-6 sm:p-8 rounded-3xl bg-cream-deep border border-sage-100">
          <div class="flex flex-col gap-1.5">
            <p class="text-xs tracking-[0.14em] uppercase text-sage-700 font-medium">{SERVICES.makExpress.duration}</p>
            <h3 class="font-serif text-2xl text-graphite font-medium leading-tight">{SERVICES.makExpress.title}</h3>
          </div>
          <div class="flex items-baseline gap-2">
            <p class="font-serif text-3xl text-sage-800 font-medium">{SERVICES.makExpress.price}</p>
            <p class="text-sm text-graphite-muted">{SERVICES.makExpress.pricePer}</p>
          </div>
          <p class="text-graphite/80 leading-relaxed flex-1">{SERVICES.makExpress.description}</p>

          <TgButton message={SERVICES.makExpress.tgMessage} label="Заказать МАК" />
        </article>
      </div>
    </div>
  </section>

  <!-- ПРОГРАММА — детально -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20 bg-sage-50">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Что внутри программы</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          4 встречи — 4 этапа подготовки
        </h2>
        <p class="text-graphite/75 leading-relaxed">
          Каждая встреча длится 50 минут, проходит онлайн раз в неделю. После каждой ты уходишь
          с конкретным артефактом и домашней практикой — не «общими ощущениями», а ясным следующим шагом.
        </p>
      </header>

      <ol class="flex flex-col gap-4">
        {programMeetings.map((m) => (
          <li class="flex flex-col gap-3 p-6 rounded-2xl bg-cream border border-sage-100">
            <div class="flex items-baseline gap-4">
              <span class="font-serif text-3xl text-sage-700 font-medium">{m.n}</span>
              <h3 class="font-serif text-xl text-graphite font-medium leading-tight">{m.title}</h3>
            </div>
            <p class="text-graphite/85 leading-relaxed">{m.body}</p>
            <p class="text-sm text-sage-800 leading-relaxed pl-4 border-l-2 border-sage-300">
              <span class="font-medium">С чем уйдёшь:</span> {m.outcome}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- КАК ПРОХОДИТ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Как это устроено</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          От первого сообщения до материалов после встречи
        </h2>
      </header>

      <ol class="flex flex-col gap-5">
        {process.map((step) => (
          <li class="flex gap-5">
            <span class="font-serif text-2xl text-sage-500 font-medium flex-shrink-0 w-8">{step.n}</span>
            <div class="flex flex-col gap-1">
              <h3 class="font-serif text-lg text-graphite font-medium">{step.title}</h3>
              <p class="text-graphite/80 leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ЧЕМ Я МОГУ ПОМОЧЬ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20 bg-sage-50">
    <div class="max-w-6xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3 max-w-2xl">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Чем я могу помочь</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Три направления работы
        </h2>
      </header>

      <div class="grid gap-6 lg:grid-cols-3">
        {directions.map((dir) => (
          <article class="flex flex-col gap-3 p-6 rounded-2xl bg-cream border border-sage-100">
            <h3 class="font-serif text-xl text-graphite font-medium">{dir.title}</h3>
            <p class="text-graphite/80 leading-relaxed">{dir.text}</p>
          </article>
        ))}
      </div>

      <aside class="flex flex-col gap-2 p-5 rounded-2xl bg-cream border border-sage-100 max-w-3xl text-sm">
        <p class="text-graphite font-medium">С чем я пока не работаю</p>
        <p class="text-graphite/75 leading-relaxed">
          ЭКО-протоколы и перинатальные потери (выкидыш, замершая беременность) — это требует отдельной
          специализации. Если у тебя этот запрос — напиши, порекомендую коллег. Острые психиатрические
          состояния — к психиатру, не ко мне.
        </p>
      </aside>
    </div>
  </section>

  <!-- МОЙ МЕТОД -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Мой метод</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Работаю в современных методах психотерапии
        </h2>
        <p class="text-graphite/75 leading-relaxed">
          Без эзотерики, гаданий и обещаний «идеальных родов». Только рабочие инструменты, у которых есть
          доказанная эффективность.
        </p>
      </header>

      <div class="grid gap-4 sm:grid-cols-2">
        {methods.map((m) => (
          <article class="flex flex-col gap-2 p-5 rounded-2xl bg-cream-deep border border-sage-100">
            <h3 class="font-serif text-lg text-graphite font-medium">{m.title}</h3>
            <p class="text-sm text-graphite/80 leading-relaxed">{m.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- УСЛОВИЯ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20 bg-sage-50">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Условия работы</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          Прозрачно, без сюрпризов
        </h2>
      </header>

      <div class="grid gap-4 sm:grid-cols-2">
        {conditions.map((c) => (
          <article class="flex flex-col gap-2 p-5 rounded-2xl bg-cream border border-sage-100">
            <h3 class="font-serif text-lg text-graphite font-medium">{c.title}</h3>
            <p class="text-sm text-graphite/80 leading-relaxed">{c.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="w-full px-4 sm:px-8 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <header class="flex flex-col gap-3">
        <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Частые вопросы</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
          На что чаще всего сомневаются
        </h2>
      </header>

      <div class="flex flex-col gap-3">
        {faq.map((item, i) => (
          <details class="group rounded-2xl border border-sage-100 bg-cream open:bg-cream-deep transition-colors duration-200">
            <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer list-none">
              <h3 class="font-serif text-lg text-graphite font-medium leading-tight pr-4">
                {item.q}
              </h3>
              <svg class="w-5 h-5 flex-shrink-0 text-sage-700 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6 -mt-1 text-graphite/80 leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full px-4 sm:px-8 py-16 sm:py-24">
    <div class="max-w-3xl mx-auto flex flex-col gap-6 p-8 sm:p-12 rounded-3xl bg-sage-50 border border-sage-100 text-center items-center">
      <h2 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">
        Не уверена, какой формат подойдёт?
      </h2>
      <p class="text-graphite/80 leading-relaxed max-w-xl">
        Напиши мне в Telegram — коротко опиши, где ты сейчас и что хочешь обсудить.
        Я отвечу в течение дня и подскажу, с чего начать.
      </p>
      <a
        href={`${CONTACT.telegramLink}?text=${encodeURIComponent("Здравствуйте, Кристина! Хочу уточнить, какой формат мне подойдёт.")}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-sage-700 text-cream hover:bg-sage-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-700 transition-colors duration-200 cursor-pointer font-medium"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
        Написать Кристине
      </a>
    </div>
  </section>
</BaseLayout>
