---
// Страница «Услуги» временно скрыта. Полная версия сохранена в _services-full.astro
// (префикс «_» = Astro не создаёт для неё маршрут). Чтобы вернуть страницу:
// 1) удалить этот файл, 2) переименовать _services-full.astro обратно в services.astro,
// 3) вернуть пункт «Услуги» в navItems (src/components/Header.astro).
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT } from "../lib/constants";
---

<BaseLayout
  title="Услуги скоро — КРИС, СКАЖИ МНЕ"
  description="Раздел с форматами работы готовится. Скоро здесь появятся программы и консультации."
>
  <section class="w-full px-4 sm:px-8 py-24 sm:py-32">
    <div class="max-w-xl mx-auto flex flex-col gap-6 items-center text-center">
      <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Услуги</p>
      <h1 class="font-serif text-3xl sm:text-4xl text-graphite font-medium leading-tight">
        Раздел готовится
      </h1>
      <p class="text-lg text-graphite/80 leading-relaxed">
        Сейчас я дорабатываю форматы работы — программы и консультации.
        Если хочешь записаться или узнать детали уже сейчас — напиши мне напрямую,
        я расскажу всё лично.
      </p>
      <a
        href={`${CONTACT.telegramLink}?text=${encodeURIComponent("Здравствуйте, Кристина! Хочу узнать про форматы работы и записаться.")}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 mt-2 px-6 py-3 rounded-full bg-sage-700 text-cream hover:bg-sage-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-700 transition-colors duration-200 cursor-pointer font-medium"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
        Написать в Telegram
      </a>
      <a href="/" class="text-sm text-sage-700 hover:text-sage-800 underline transition-colors duration-200">
        Вернуться на главную
      </a>
    </div>
  </section>
</BaseLayout>
