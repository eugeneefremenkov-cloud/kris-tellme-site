<style>
  /* Tariff content — hidden state stays flex-col when shown */
  [data-tariff-content].hidden {
    display: none;
  }
  [data-tariff-content]:not(.hidden) {
    display: flex;
  }

  /* Highlighted format card when recommended via audience selector */
  .format-card.is-recommended {
    border-color: var(--color-sage-500);
    box-shadow: 0 0 0 3px rgba(136, 163, 125, 0.18), var(--shadow-soft);
  }
  .format-card.is-dimmed {
    opacity: 0.6;
  }
</style>

<script>
  // Tariff tabs внутри каждой программной карточки
  document.querySelectorAll<HTMLElement>("[data-format-card]").forEach((card) => {
    const tabs = card.querySelectorAll<HTMLButtonElement>(".tariff-tab");
    const contents = card.querySelectorAll<HTMLElement>("[data-tariff-content]");
    if (tabs.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const tariff = tab.getAttribute("data-tariff");
        tabs.forEach((t) => t.setAttribute("data-active", t === tab ? "true" : "false"));
        contents.forEach((c) => {
          const matches = c.getAttribute("data-tariff-content") === tariff;
          c.classList.toggle("hidden", !matches);
        });
      });
    });
  });

  // Селектор аудитории → подсветить рекомендованную карточку
  const selector = document.querySelector<HTMLElement>("[data-audience-selector]");
  const noteEl = document.getElementById("audience-note");
  const audienceBtns = selector?.querySelectorAll<HTMLButtonElement>(".audience-btn") || [];
  const allFormatCards = document.querySelectorAll<HTMLElement>("[data-format-card]");

  audienceBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isActive = btn.getAttribute("data-active") === "true";

      // Сбросить всё
      audienceBtns.forEach((b) => b.setAttribute("data-active", "false"));
      allFormatCards.forEach((c) => {
        c.classList.remove("is-recommended", "is-dimmed");
        c.querySelector(".recommended-badge")?.classList.add("hidden");
      });

      // Если клик по уже активной — просто сбрасываем
      if (isActive) {
        noteEl?.classList.add("hidden");
        return;
      }

      // Активировать кнопку и применить подсветку
      btn.setAttribute("data-active", "true");
      const target = btn.getAttribute("data-audience-target");
      const note = btn.getAttribute("data-audience-note") || "";

      allFormatCards.forEach((c) => {
        const slug = c.getAttribute("data-format-card");
        if (slug === target) {
          c.classList.add("is-recommended");
          c.querySelector(".recommended-badge")?.classList.remove("hidden");
        } else {
          c.classList.add("is-dimmed");
        }
      });

      if (noteEl) {
        noteEl.textContent = note;
        noteEl.classList.remove("hidden");
      }
    });
  });
</script>
