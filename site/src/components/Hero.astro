---
import { Image } from "astro:assets";
import { BRAND } from "../lib/constants";
import kristinaHero from "../assets/images/kristina-hero.jpg";
---

<section class="w-full px-4 sm:px-8 pt-8 pb-16 sm:pt-16 sm:pb-24">
  <div class="max-w-6xl mx-auto grid gap-10 sm:gap-16 sm:grid-cols-2 sm:items-center">
    <div class="order-2 sm:order-1 flex flex-col gap-6">
      <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">
        {BRAND.title}
      </p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.1] text-graphite font-medium">
        Помогаю женщинам спокойно встретить роды
      </h1>
      <p class="text-lg sm:text-xl text-graphite/80 leading-relaxed max-w-md">
        Работаю с дородовой и послеродовой тревогой. Поддержка, инструменты, ясность — для тебя и малыша.
      </p>
      <a
        href="#cards"
        class="inline-flex items-center justify-center self-start mt-2 px-6 py-3 rounded-full bg-sage-700 text-cream hover:bg-sage-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-700 transition-colors duration-200 cursor-pointer font-medium"
      >
        Получить копинг-карточку
      </a>
    </div>

    <div class="order-1 sm:order-2">
      <Image
        src={kristinaHero}
        alt="Кристина Ефременкова — перинатальный психолог"
        widths={[400, 600, 800, 1000]}
        sizes="(min-width: 640px) 50vw, 100vw"
        format="webp"
        quality={82}
        loading="eager"
        class="w-full aspect-[3/4] object-cover rounded-3xl shadow-[var(--shadow-soft-lg)]"
      />
    </div>
  </div>
</section>
