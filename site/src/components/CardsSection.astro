---
import { COPING_CARDS } from "../lib/constants";

const [heroCard, ...rest] = COPING_CARDS;
---

<section id="cards" class="w-full px-4 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto flex flex-col gap-12">
    <header class="flex flex-col gap-3 max-w-2xl">
      <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Бесплатные материалы</p>
      <h2 class="font-serif text-3xl sm:text-4xl text-graphite font-medium leading-tight">Копинг-карточки</h2>
      <p class="text-graphite/70 leading-relaxed">
        Сохрани на телефон, поставь на заставку или распечатай. Перечитывай в моменты тревоги — это работает.
      </p>
    </header>

    {heroCard && (
      <article class="grid gap-8 sm:gap-12 sm:grid-cols-2 sm:items-center p-6 sm:p-10 rounded-3xl bg-sage-50">
        <img
          src={heroCard.pngUrl}
          alt={heroCard.title}
          class="w-full aspect-[3/4] object-cover rounded-2xl shadow-[var(--shadow-soft)] bg-cream"
          loading="lazy"
        />
        <div class="flex flex-col gap-4">
          <h3 class="font-serif text-2xl sm:text-3xl text-graphite font-medium leading-tight">{heroCard.title}</h3>
          <p class="text-graphite/80 leading-relaxed">{heroCard.description}</p>
          <a
            href={heroCard.pngUrl}
            download
            class="inline-flex items-center justify-center gap-2 self-start px-6 py-3 rounded-full bg-sage-700 text-cream hover:bg-sage-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-700 transition-colors duration-200 cursor-pointer font-medium"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Скачать PNG
          </a>
        </div>
      </article>
    )}

    {rest.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((card) => (
          <article class="flex flex-col gap-3 p-5 rounded-2xl bg-cream-deep border border-sage-100">
            <img src={card.pngUrl} alt={card.title} class="w-full aspect-[3/4] object-cover rounded-xl" loading="lazy" />
            <h3 class="font-serif text-xl text-graphite font-medium">{card.title}</h3>
            <p class="text-sm text-graphite/70 leading-relaxed">{card.description}</p>
            <a href={card.pngUrl} download class="text-sm text-sage-700 underline self-start hover:text-sage-800 transition-colors duration-200 cursor-pointer">
              Скачать PNG
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
