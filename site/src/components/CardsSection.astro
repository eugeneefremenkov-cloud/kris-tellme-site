---
import { COPING_CARDS } from "../lib/constants";
---

<section id="cards" class="w-full px-4 sm:px-8 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto flex flex-col gap-12">
    <header class="flex flex-col gap-3 max-w-2xl">
      <p class="text-sage-700 text-xs tracking-[0.18em] uppercase font-medium">Бесплатные материалы</p>
      <h2 class="font-serif text-3xl sm:text-4xl text-graphite font-medium leading-tight">Копинг-карточки</h2>
      <p class="text-graphite/70 leading-relaxed">
        Сохрани на телефон, поставь на заставку или распечатай. Перечитывай в моменты тревоги — это работает.
      </p>
    </header>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {COPING_CARDS.map((card) => (
        <article class="flex flex-col gap-4">
          <button
            type="button"
            class="card-trigger group block w-full text-left cursor-pointer"
            data-target={card.slug}
            aria-label={`Открыть карточку: ${card.title}`}
          >
            <img
              src={card.pngUrl}
              alt={card.title}
              loading="lazy"
              class="w-full aspect-[3/4] object-cover rounded-2xl shadow-[var(--shadow-soft)] bg-cream transition-shadow duration-200 group-hover:shadow-[var(--shadow-soft-lg)]"
            />
          </button>

          <div class="flex flex-col gap-2">
            <h3 class="font-serif text-xl sm:text-2xl text-graphite font-medium leading-tight">{card.title}</h3>
            <p class="text-sm text-graphite/70 leading-relaxed">{card.description}</p>
          </div>

          <a
            href={card.pngUrl}
            download
            class="inline-flex items-center gap-2 self-start text-sm text-sage-700 hover:text-sage-800 transition-colors duration-200 cursor-pointer font-medium"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Скачать PNG
          </a>
        </article>
      ))}
    </div>

    {COPING_CARDS.map((card) => (
      <dialog
        id={`dialog-${card.slug}`}
        class="card-dialog"
        aria-labelledby={`dialog-title-${card.slug}`}
      >
        <div class="dialog-inner">
          <button
            type="button"
            class="dialog-close"
            aria-label="Закрыть"
          >
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <img
            src={card.pngUrl}
            alt={card.title}
            class="dialog-image"
            id={`dialog-title-${card.slug}`}
          />

          <a
            href={card.pngUrl}
            download
            class="dialog-download"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Скачать PNG
          </a>
        </div>
      </dialog>
    ))}
  </div>
</section>

<style>
  .card-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .card-dialog::backdrop {
    background: rgba(42, 42, 40, 0.78);
    backdrop-filter: blur(8px);
  }

  .card-dialog[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dialog-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 1rem;
    max-height: 100vh;
  }

  .dialog-image {
    max-width: min(90vw, 700px);
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .dialog-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: rgba(250, 247, 241, 0.95);
    color: #2A2A28;
    border: none;
    cursor: pointer;
    transition: background 200ms ease;
    z-index: 1;
  }

  .dialog-close:hover {
    background: #FAF7F1;
  }

  .dialog-close:focus-visible {
    outline: 2px solid #FAF7F1;
    outline-offset: 2px;
  }

  .dialog-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    background: #FAF7F1;
    color: #556E4C;
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background 200ms ease;
  }

  .dialog-download:hover {
    background: #E3EBE0;
  }

  .dialog-download:focus-visible {
    outline: 2px solid #FAF7F1;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-dialog::backdrop {
      backdrop-filter: none;
    }
  }
</style>

<script>
  // Открытие карточки по клику на превью
  document.querySelectorAll<HTMLButtonElement>(".card-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const slug = btn.getAttribute("data-target");
      if (!slug) return;
      const dialog = document.getElementById(`dialog-${slug}`) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  // Кнопки закрытия
  document.querySelectorAll<HTMLButtonElement>(".dialog-close").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dialog = btn.closest("dialog") as HTMLDialogElement | null;
      dialog?.close();
    });
  });

  // Клик по backdrop → закрыть
  document.querySelectorAll<HTMLDialogElement>(".card-dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>
